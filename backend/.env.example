# Optional shared secret. If set, clients must send X-API-Key.
TRILLROKU_API_KEY=replace-with-a-long-random-value

# Comma-separated browser origins, or * for a public API with no cookies.
# Native Roku requests do not use browser CORS.
TRILLROKU_CORS_ORIGINS=*

# Optional exact host allowlist, comma-separated. Leave blank to permit public hosts.
# Example: TRILLROKU_ALLOWED_HOSTS=videos.example.org,media.example.org
TRILLROKU_ALLOWED_HOSTS=

# Must point to persistent storage in production so Android scan codes survive deploys.
TRILLROKU_DB_PATH=trillroku.sqlite3

TRILLROKU_PORT=8000
